# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================
DB_URL=jdbc:mysql://localhost:3306/expensetracker?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ===================================================================
# JWT SECURITY CONFIGURATION
# ===================================================================
# Generate a strong secret key (256+ bits recommended)
# You can generate one using: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_key_here_minimum_256_bits
JWT_EXPIRATION=86400000

# ===================================================================
# SPRING SECURITY CONFIGURATION
# ===================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ===================================================================
# ENVIRONMENT PROFILE
# ===================================================================
# Options: dev, test, prod
SPRING_PROFILES_ACTIVE=dev

# ===================================================================
# LOGGING CONFIGURATION
# ===================================================================
# Options: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARN

# ===================================================================
# CORS CONFIGURATION
# ===================================================================
# Comma-separated list of allowed origins
# Development: http://localhost:3000,http://localhost:8080
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
